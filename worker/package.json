{
  "name": "quest-session-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drives Playwright's persistent browser context on behalf of the Rust quest CLI.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
