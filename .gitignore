# Rust
/target
**/*.rs.bk

# Node
node_modules/
worker/dist/

# ---------------------------------------------------------------------------
# Crown jewels. The persisted browser profile is a bearer token for the entire
# student record. It must never be committed, synced, or shared.
# ---------------------------------------------------------------------------
profile/
*.profile/
audit.log

# These are *data-dir* names, so they stay anchored to the repo root. Unanchored,
# `session/` silently swallowed `crates/quest-core/src/session/` — the entire wire
# protocol and worker transport — and a fresh clone would not compile.
/session/

# Captured traffic from real sessions contains live cookies + personal data.
# Only *sanitized* fixtures belong in fixtures/ — see fixtures/README.md.
*.har
!fixtures/har/*.sanitized.har

.DS_Store
.env
.env.*
